<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Suri Frey - Digitální Vzorkovna</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background: #fff; color: #333; }
        header { padding: 30px; text-align: center; border-bottom: 1px solid #eee; position: sticky; top: 0; background: white; z-index: 100; }
        .nav-brands button { background: none; border: 1px solid #ccc; padding: 10px 20px; margin: 5px; cursor: pointer; transition: 0.3s; }
        .nav-brands button.active { background: #000; color: #fff; }
        
        .container { max-width: 1100px; margin: 20px auto; padding: 0 20px; }
        
        /* Kolekce */
        .collection-group { margin-top: 60px; border-top: 2px solid #000; padding-top: 20px; }
        .collection-name { font-size: 24px; font-weight: bold; text-transform: uppercase; margin-bottom: 20px; letter-spacing: 2px; }

        /* Řádek s kabelkou */
        .bag-row { display: grid; grid-template-columns: 350px 1fr 150px; gap: 30px; padding: 30px 0; border-bottom: 1px solid #f0f0f0; align-items: start; }
        
        .carousel-box { width: 350px; height: 350px; background: #f9f9f9; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .carousel-box img { max-width: 100%; max-height: 100%; transition: opacity 0.3s; }

        .info-box h3 { margin: 0 0 10px 0; font-size: 18px; }
        .price { font-size: 20px; font-weight: 600; color: #000; margin-bottom: 15px; }
        
        .color-options { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
        .color-swatch { width: 30px; height: 30px; border-radius: 50%; cursor: pointer; border: 2px solid #fff; box-shadow: 0 0 0 1px #ddd; position: relative; }
        .color-swatch:hover { transform: scale(1.1); }
        .color-swatch.active { box-shadow: 0 0 0 2px #000; }
        .color-label { font-size: 11px; display: block; text-align: center; margin-top: 32px; color: #888; }

        .order-box { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; border-left: 1px solid #eee; }
        .check-container { font-size: 14px; text-align: center; cursor: pointer; }
        .check-container input { width: 25px; height: 25px; cursor: pointer; }

        #summary-bar { position: fixed; bottom: 0; width: 100%; background: #000; color: #fff; padding: 15px; text-align: center; display: none; }
    </style>
</head>
<body>

<header>
    <h1>DIGITÁLNÍ VZORKOVNA</h1>
    <div class="nav-brands">
        <button onclick="alert('Bude doplněno')">TAMARIS</button>
        <button class="active">SURI FREY</button>
        <button onclick="alert('Bude doplněno')">EMILY & NOAH</button>
    </div>
</header>

<div class="container" id="main-content">
    <!-- Tady JS vygeneruje kolekce -->
</div>

<div id="summary-bar">
    Máte vybráno <span id="count">0</span> položek. <button style="margin-left:20px; padding: 5px 15px; cursor:pointer;">ZOBRAZIT POPTÁVKU</button>
</div>

<script>
    // Ukázka dat z vaší tabulky
    const data = [
        { brand: "Suri Frey", coll: "SFY Debby", model: "13600", price: "1 399 Kč", colors: ["100", "300", "420", "500", "950"] },
        { brand: "Suri Frey", coll: "SFY Debby", model: "13601", price: "1 599 Kč", colors: ["100", "300", "420", "500", "950"] },
        { brand: "Suri Frey", coll: "SFY Angy SC", model: "17381", price: "1 249 Kč", colors: ["100", "200", "700", "900"] },
        { brand: "Suri Frey", coll: "SFY Angy SC", model: "17382", price: "1 799 Kč", colors: ["100", "200", "700", "900"] }
    ];

    function renderShowroom() {
        const container = document.getElementById('main-content');
        const groups = {};

        // Seskupení podle kolekcí
        data.forEach(item => {
            if (!groups[item.coll]) groups[item.coll] = [];
            groups[item.coll].push(item);
        });

        for (const collName in groups) {
            let collHtml = `<section class="collection-group">
                <div class="collection-name">${collName}</div>`;
            
            groups[collName].forEach(bag => {
                collHtml += `
                <div class="bag-row" id="row-${bag.model}">
                    <div class="carousel-box">
                        <img id="img-${bag.model}" src="https://via.placeholder.com/350?text=Model+${bag.model}+Barva+${bag.colors[0]}" alt="${bag.model}">
                    </div>
                    <div class="info-box">
                        <h3>Vzor č. ${bag.model}</h3>
                        <div class="price">${bag.price}</div>
                        <p><small>Materiál: Měkký syntetický materiál s jemnou texturou.</small></p>
                        <div class="color-options">
                            ${bag.colors.map((c, index) => `
                                <div class="color-swatch ${index === 0 ? 'active' : ''}" 
                                     style="background: ${getColorHex(c)}" 
                                     onclick="updateVariant('${bag.model}', '${c}', this)">
                                     <span class="color-label">${c}</span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="order-box">
                        <label class="check-container">
                            <input type="checkbox" id="check-${bag.model}" onchange="updateCount()">
                            <br>VYBRAT
                        </label>
                    </div>
                </div>`;
            });
            
            collHtml += `</section>`;
            container.innerHTML += collHtml;
        }
    }

    // Pomocná funkce pro simulaci barev (zde by byly reálné barvy)
    function getColorHex(code) {
        const colors = { "100": "#000", "200": "#8B4513", "300": "#D2B48C", "420": "#556B2F", "500": "#4682B4", "700": "#800000", "900": "#555", "950": "#222" };
        return colors[code] || "#ccc";
    }

    function updateVariant(modelId, colorCode, element) {
        // 1. Změna fotky (simulace)
        const img = document.getElementById(`img-${modelId}`);
        img.style.opacity = '0.3';
        setTimeout(() => {
            img.src = `https://via.placeholder.com/350?text=Model+${modelId}+Barva+${colorCode}`;
            img.style.opacity = '1';
        }, 200);

        // 2. Reset checkboxu (protože jde o jinou barvu)
        const cb = document.getElementById(`check-${modelId}`);
        cb.checked = false;

        // 3. Aktivní vzhled barvy
        const row = document.getElementById(`row-${modelId}`);
        row.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
        element.classList.add('active');
        
        updateCount();
    }

    function updateCount() {
        const checked = document.querySelectorAll('input[type="checkbox"]:checked').length;
        const bar = document.getElementById('summary-bar');
        document.getElementById('count').innerText = checked;
        bar.style.display = checked > 0 ? 'block' : 'none';
    }

    renderShowroom();
</script>

</body>
</html>